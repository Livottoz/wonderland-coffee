
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Livro - Wonderland Coffee</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f7f1e8;
      color: #3b2920;
      padding: 30px;
    }

    .container {
      max-width: 550px;
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 10px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-top: 15px;
    }

    input {
      width: 100%;
      padding: 10px;
      margin-top: 6px;
      box-sizing: border-box;
    }

    .botao {
      display: inline-block;
      background: #76513a;
      color: white;
      padding: 12px 18px;
      border: none;
      border-radius: 6px;
      margin-top: 20px;
      text-decoration: none;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <main class="container">
    <h1>Editar livro 📚</h1>

    <form method="POST"
          action="/admin/livros/editar/<%= livro.id_livro %>">

      <label for="titulo">Título do livro</label>
      <input type="text" id="titulo" name="titulo"
             value="<%= livro.titulo %>"
             maxlength="200" required>

      <label for="autor">Autor</label>
      <input type="text" id="autor" name="autor"
             value="<%= livro.autor %>"
             maxlength="150" required>

      <label for="isbn">ISBN</label>
      <input type="text" id="isbn" name="isbn"
             value="<%= livro.isbn || '' %>"
             maxlength="20">

      <label for="preco">Preço (R$)</label>
      <input type="number" id="preco" name="preco"
             value="<%= Number(livro.preco).toFixed(2) %>"
             min="0" step="0.01" required>

      <label for="estoque">Estoque</label>
      <input type="number" id="estoque" name="estoque"
             value="<%= livro.estoque %>"
             min="0" step="1" required>

      <button class="botao" type="submit">
        Salvar alterações
      </button>

      <a class="botao" href="/admin/livros">
        Cancelar
      </a>
    </form>
  </main>
</body>
</html>
