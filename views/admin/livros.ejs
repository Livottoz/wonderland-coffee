
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gerenciar Livros - Wonderland Coffee</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f7f1e8;
      color: #3b2920;
      padding: 30px;
    }

    .container {
      max-width: 1100px;
      margin: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      margin-top: 20px;
    }

    th, td {
      padding: 12px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }

    th {
      background: #e8d8c6;
    }

    .botao {
      display: inline-block;
      padding: 10px 15px;
      background: #76513a;
      color: white;
      text-decoration: none;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }

    .excluir {
      background: #a83f3f;
    }

    .acoes {
      display: flex;
      gap: 8px;
    }

    form {
      margin: 0;
    }
  </style>
</head>
<body>
  <main class="container">
    <h1>Gerenciamento da Livraria 📚</h1>

    <p>Administre os livros cadastrados no Wonderland Coffee.</p>

    <a class="botao" href="/admin/livros/novo">
      + Cadastrar livro
    </a>

    <a class="botao" href="/admin/produtos">
      Gerenciar cafeteria
    </a>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Autor</th>
          <th>ISBN</th>
          <th>Preço</th>
          <th>Estoque</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% livros.forEach(livro => { %>
          <tr>
            <td><%= livro.id %></td>
            <td><%= livro.titulo %></td>
            <td><%= livro.autor %></td>
            <td><%= livro.isbn || '-' %></td>
            <td>R$ <%= Number(livro.preco).toFixed(2) %></td>
            <td><%= livro.estoque %></td>
            <td>
              <div class="acoes">
                <a class="botao"
                   href="/admin/livros/editar/<%= livro.id %>">
                  Editar
                </a>

                <form method="POST"
                      action="/admin/livros/excluir/<%= livro.id %>">
                  <button class="botao excluir" type="submit">
                    Excluir
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (livros.length === 0) { %>
      <p>Nenhum livro cadastrado.</p>
    <% } %>
  </main>
</body>
</html>
